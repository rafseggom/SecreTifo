# SecretKit — configuración del SDK Web de Firebase (Vite).
#
# Copia este archivo a `.env.local` y rellena los valores de la consola de Firebase:
#   Configuración del proyecto > General > Tus apps > Configuración del SDK.
# Solo las variables con prefijo VITE_ se exponen al bundle del cliente.
# `.env.local` está en .gitignore y NUNCA debe commitearse.
#
# La app falla explícitamente al arrancar si alguna de estas variables falta
# (src/lib/firebase.ts nombra la variable ausente); no hay `undefined` silencioso.
VITE_FIREBASE_API_KEY="tu-api-key"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Admin secret — gate for /admin/setup and /admin/login (UI gate only, not cryptographic).
# Replace with a strong random string.
VITE_ADMIN_SECRET="tu_clave_secreta_aqui"
