rules_version = '2';

// SecretKit Firestore Security Rules — DEFAULT DENY (D-06, SEC-01).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin secret: "admin123" (shared-password model)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin_secret == 'admin123';
    }

    // Helper: get participant by nameNormalized
    function getParticipant(nameNormalized) {
      return get(/databases/$(database)/documents/events/main/participants/$(nameNormalized));
    }

    // Helper: is owner of participant
    function isOwner(nameNormalized) {
      return isSignedIn() && getParticipant(nameNormalized).data.ownerUid == request.auth.uid;
    }

    // Helper: event exists and is in lobby
    function eventInLobby() {
      return exists(/databases/$(database)/documents/events/main) &&
             get(/databases/$(database)/documents/events/main).data.status == 'lobby';
    }

    // Helper: event exists and is drawn
    function eventDrawn() {
      return exists(/databases/$(database)/documents/events/main) &&
             get(/databases/$(database)/documents/events/main).data.status == 'drawn';
    }

    match /events/main {
      allow get: if isSignedIn();

      // Bootstrap: FIRST user creates event and becomes admin
      allow create: if isSignedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.participantCount == 1;

      // Update: admin can flip lobby -> drawn (forward only)
      allow update: if isAdmin()
        && request.resource.data.adminUid == resource.data.adminUid
        && (resource.data.status == 'drawn'
          ? request.resource.data.status == 'drawn'
          : request.resource.data.status in ['lobby', 'drawn']);

      allow delete: if false;

      // PARTICIPANTS - keyed by nameNormalized
      match /participants/{nameNormalized} {
        allow get, list: if isSignedIn();

        // Create participant: any signed-in user, event must be in lobby (or being created in same tx)
        allow create: if isSignedIn()
          && nameNormalized == request.resource.data.nameNormalized
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.nameNormalized is string
          && request.resource.data.size in ['S','M','L','XL','XXL','XXXL']
          && (eventInLobby() || request.resource.data.allowBootstrap == true);

        // Update: owner can update; after draw only hasOrder and pinHash
        allow update: if isSignedIn()
          && isOwner(nameNormalized)
          && request.resource.data.name == resource.data.name
          && request.resource.data.nameNormalized == nameNormalized
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.size in ['S','M','L','XL','XXL','XXXL']
          && (
            eventInLobby()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasOrder', 'pinHash'])
          );

        // Delete: owner (collision rollback) or admin (liberar)
        allow delete: if isSignedIn() && (isOwner(nameNormalized) || isAdmin());
      }

      // ASSIGNMENTS - keyed by giver nameNormalized
      match /assignments/{giverNameNormalized} {
        // Giver reads own assignment
        allow get: if isSignedIn() && isOwner(giverNameNormalized);

        // No list for anyone
        allow list: if false;

        // Admin writes via draw
        allow create, update: if isAdmin();

        allow delete: if false;
      }

      // ORDERS - keyed by giver nameNormalized
      match /orders/{giverNameNormalized} {
        allow get: if isSignedIn() && (isOwner(giverNameNormalized) || isAdmin());
        allow list: if isAdmin();

        allow create, update: if isSignedIn()
          && isOwner(giverNameNormalized)
          && request.resource.data.number is string
          && !('recipientUid' in request.resource.data)
          && !('recipientName' in request.resource.data);

        allow delete: if false;
      }
    }
  }
}